# Define a function to extract p-value from a linear model object
lmp <- function (modelobject) {
if (class(modelobject) != "lm") stop("Not an object of class 'lm' ")
f <- summary(modelobject)$fstatistic
p <- pf(f[1], f[2], f[3], lower.tail = F)  # Calculate p-value from F-stat
attributes(p) <- NULL
return(p)
}#OBSOLETE --- CAN BE REMOVED
