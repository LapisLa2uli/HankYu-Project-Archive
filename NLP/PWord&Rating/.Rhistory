if (NewData$avg_score[i] > 3 & NewData$avg_score[i] <= 6) {
NewData$decision[i] = 2
}
if (NewData$avg_score[i] > 6) {
NewData$decision[i] = 3
}
}
# Ensure decisions are integers
for (i in seq.int(from = 1, to = length(NewData$decision))) {
NewData$decision[i] = as.integer(NewData$decision[i])
}
# Cap the dataset to a specific range (perhaps to ensure consistency across runs)
#NewData = NewData[1:13352, ]
# Convert decision to an ordered factor for ordinal regression
NewData$decision = as.integer(NewData$decision)
NewData$decision = as.factor(NewData$decision)
NewData$decision <- ordered(NewData$decision, levels = c(1, 2, 3))
# Convert categorical predictors to character for regression
NewData$year <- as.character(NewData$year)
NewData$num_words_5cats <- as.character(NewData$num_words_5cats)
# Load library for ordinal regression
library(MASS)
# Run ordinal logistic regression (proportional odds model)
model <- polr(decision ~ frac_hype_words +
flesch_reading_ease +
concreteness +
year +
num_words_5cats +
women_perc,
data = NewData,
Hess = TRUE)
summary(model)
NewData$confidence=ordered(NewData$decision, levels = c(1, 2, 3, 4, 5))
print(length(NewData$confidence))
print(length(NewData$frac_hype_words))
# Fit another model based only on 'confidence' as a predictor
model <= polr(confidence ~ frac_hype_words, data = NewData, Hess = TRUE)
